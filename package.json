{
  "name": "interprete-salle",
  "version": "0.1.0",
  "private": true,
  "description": "Interprétation IA temps réel EN ↔ FR pour salle de formation",
  "workspaces": [
    "shared",
    "server",
    "client",
    "desktop"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client && npm run typecheck -w desktop",
    "desktop": "npm run dev -w desktop",
    "replay": "npm run replay -w server --",
    "check": "npm run check -w server --",
    "voices": "npm run voices -w server --",
    "load": "npm run load -w server --",
    "cert:dev": "npm run cert:dev -w server --",
    "cert:domain": "npm run cert:domain -w server --",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose stop db",
    "db:reset": "docker compose down -v db"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
