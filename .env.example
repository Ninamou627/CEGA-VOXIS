# ---------- Serveur ----------
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
SESSION_ID=TRAINING-01
SRC_LANG=en
# Langues cibles séparées par des virgules. Une seule pour le MVP.
TARGET_LANGS=fr
# URL publique encodée dans le QR code. Vide = IP LAN détectée automatiquement.
# En salle : PORT=443 et https://institutcega.fr (voir docs/CERTIFICAT.md).
PUBLIC_URL=
# Certificat TLS. Vide = HTTP. npm run cert:domain (Let's Encrypt, en salle)
# ou npm run cert:dev (auto-signé, en développement).
TLS_CERT=
TLS_KEY=
# Jeton API Hostinger (hPanel → Profil → API) : le nom de PUBLIC_URL suit l'IP du PC
# et le certificat se renouvelle seul. Sur le PC de salle seulement.
HOSTINGER_API_TOKEN=

# ---------- Authentification (D17) ----------
# Comptes, sessions de connexion et code de séance. En développement : npm run db:up
DATABASE_URL=postgres://voxis:voxis-dev@127.0.0.1:5432/voxis
# Compte d'administration créé au tout premier démarrage, et lui seul. Sans mot de passe
# ici, le serveur en tire un au hasard et l'affiche une fois dans son journal.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Durée d'une session de connexion, puis d'un code de séance, en heures.
SESSION_HOURS=12
CODE_HOURS=12
# true derrière un reverse proxy (Caddy, nginx), pour que le frein sur les essais de
# mot de passe voie la vraie adresse du visiteur et non celle du proxy.
TRUST_PROXY=false
METRICS_FILE=metrics.jsonl
# Réglages enregistrés depuis l'administration (remplacent les valeurs de ce fichier)
# et compteurs de long terme (temps traduit, disponibilité, qualité).
SETTINGS_FILE=data/settings.json
TOTALS_FILE=data/totals.json
# Installeurs de l'application Windows et flux de mise à jour (voir desktop/README.md).
DOWNLOAD_DIR=data/telechargements

# ---------- Fournisseurs ----------
# mock = aucune clé nécessaire, tout le pipeline tourne en local.
STT_PROVIDER=mock          # mock | assemblyai | deepgram
MT_PROVIDER=mock           # mock | anthropic | deepl
MT_BACKUP=none             # none | deepl | anthropic | mock — relais 60 s si le primaire échoue
TTS_PROVIDER=mock          # mock | elevenlabs | azure
TTS_BACKUP=none            # none | azure | elevenlabs | mock — relais 60 s si le primaire échoue
# audio : le STT simulé avance au rythme de l'audio reçu du micro.
# timer : il avance tout seul (démo sans micro).
MOCK_STT_CLOCK=audio

# Validez n'importe quelle clé en 30 s : npm run check

ANTHROPIC_API_KEY=
# À comparer avec claude-haiku-4-5 sur la fixture : la latence du premier token
# est le critère, pas le prix.
MT_MODEL=claude-opus-5
# Glossaire imposé au traducteur (Anthropic) : « terme source=rendu cible ; … ». À remplir avec le formateur.
MT_GLOSSARY=

# Clé gratuite : se termine par « :fx » (api-free.deepl.com, 500 000 caractères/mois).
DEEPL_API_KEY=

ASSEMBLYAI_API_KEY=
ASSEMBLYAI_MODEL=universal-3-5-pro
ASSEMBLYAI_REGION=eu            # eu (RGPD) | us | edge
ASSEMBLYAI_MODE=balanced        # min_latency | balanced | max_accuracy — à départager sur la fixture
ASSEMBLYAI_VOICE_FOCUS=none     # none | near-field | far-field
# Ignore les tours reconnus dans une autre langue que la source : anti-boucle (haut-parleurs
# captés par le micro) et anti-intrus (apprenant francophone près du micro).
ASSEMBLYAI_LANGUAGE_GATE=true
# Glossaire côté STT (même liste que pour la traduction) :
STT_PROMPT=
STT_KEYTERMS=

DEEPGRAM_API_KEY=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=            # voix française (langue cible)
ELEVENLABS_VOICE_ID_EN=         # optionnel : voix anglaise pour les questions au formateur
ELEVENLABS_MODEL=eleven_turbo_v2_5

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=            # ex. francecentral, westeurope
AZURE_TTS_VOICE=fr-FR-DeniseNeural
AZURE_TTS_VOICE_EN=en-US-JennyNeural
