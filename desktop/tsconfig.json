{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // Le processus principal d'Electron : CommonJS, le chemin le mieux éprouvé.
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"]
}
